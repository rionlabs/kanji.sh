{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "nx run kanji.sh:build --prod",
  "devCommand": "nx run kanji.sh:dev",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "./print-assets/**/*"
    }
  },
  "framework": "nextjs",
  "ignoreCommand": "node tools/skipDeploy.js",
  "installCommand": "npm install",
  "outputDirectory": "dist/apps/kanji.sh",
  "trailingSlash": false
}
