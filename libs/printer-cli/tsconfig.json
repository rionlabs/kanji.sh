{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@kanji-sh/models": ["dist/libs/models/src/index.d.ts"],
      "@kanji-sh/printer": ["dist/libs/printer/src/index.d.ts"]
    }
  },
  "files": [],
  "include": ["src/**/*.ts", "../../libs/models/src/**/*.ts", "../../libs/printer/src/**/*.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
