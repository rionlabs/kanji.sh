{
  "name": "printer-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/printer-cli/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/printer-cli",
        "main": "libs/printer-cli/src/index.ts",
        "tsConfig": "libs/printer-cli/tsconfig.json",
        "bundle": true,
        "platform": "node",
        "format": ["cjs"],
        "outputFileName": "index.cjs",
        "skipTypeCheck": true,
        "esbuildOptions": {
          "alias": {
            "@kanji-sh/models": "./libs/models/src/index.ts",
            "@kanji-sh/printer": "./libs/printer/src/index.ts"
          }
        },
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/printer-cli/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
